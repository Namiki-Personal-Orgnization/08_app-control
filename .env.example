# ===========================================
# Vercel + Supabase インテグレーションが自動セットする環境変数
# （Deploy Button からデプロイすればここは自動で埋まる）
# ===========================================

# --- データベース（Supabase Postgres）---
# Prisma がクエリで使う（pgbouncer 経由）
POSTGRES_PRISMA_URL="postgres://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=15"
# Prisma マイグレーションで使う（Direct connection）
POSTGRES_URL_NON_POOLING="postgres://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Supabase Storage（写真アップロード）---
NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ===========================================
# 手動で設定する環境変数（Deploy Button 時に入力可）
# ===========================================

# Storage バケット名（Supabase ダッシュボードで作成したものを指定）
SUPABASE_STORAGE_BUCKET="inventory-photos"

# iron-session の暗号化キー（32文字以上のランダム文字列）
# 生成例: openssl rand -base64 32
SESSION_PASSWORD="please-change-me-to-a-random-string-at-least-32-chars"

# 現場スタッフ共有ログイン（ID は "staff" 固定）
STAFF_PASSWORD="staff-shared-password"
# 管理者ログイン（ID は "admin" 固定）
ADMIN_PASSWORD="admin-strong-password"

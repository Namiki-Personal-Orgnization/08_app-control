// ホテル在庫管理ツール Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Location {
  id        String   @id @default(cuid())
  floor     String
  roomName  String
  photoUrl  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots InventorySnapshot[]
  stockLogs StockLog[]

  @@index([floor])
}

model Item {
  id             String   @id @default(cuid())
  name           String
  category       String?
  photoUrl       String?
  baseUnit       String   @default("個")
  unitRates      Json     @default("[]")
  alertEnabled   Boolean  @default(false)
  alertThreshold Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  snapshots InventorySnapshot[]
  stockLogs StockLog[]

  @@index([category])
}

enum StockLogType {
  ARRIVAL
  COUNT
}

model StockLog {
  id           String       @id @default(cuid())
  occurredAt   DateTime     @default(now())
  type         StockLogType
  itemId       String
  locationId   String
  quantityBase Int
  rawInputs    Json
  operator     String
  note         String?

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([itemId, occurredAt])
  @@index([locationId, occurredAt])
  @@index([type, occurredAt])
}

model InventorySnapshot {
  id           String   @id @default(cuid())
  yearMonth    String
  itemId       String
  locationId   String
  confirmedQty Int
  rawInputs    Json
  operator     String
  confirmedAt  DateTime @default(now())

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([yearMonth, itemId, locationId])
  @@index([yearMonth])
}

model MonthlyCloseStatus {
  yearMonth String    @id
  closedAt  DateTime?
  closedBy  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
